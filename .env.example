# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=nation-team
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8080
# Public SPA mount used by pairing links and QR codes.
OMB_PUBLIC_URL=https://thenation.city/swarm
# Leave empty to inherit OMB_PUBLIC_URL.
OMB_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set OMB_PUBLIC_URL to https:// followed by the same hostname.
# Requires OMB_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
OMB_HTTPS_HOST=
OMB_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
OMB_LOCAL_IMAGE=nation-team-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
# Claude Code and Codex require direct Anthropic / OpenAI keys.
# Set OPENROUTER_API_KEY instead to use OpenRouter (no Anthropic/OpenAI key needed).
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
OMB_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
OMB_DATA_EXTERNAL=false

# ── Nation OpenRouter (server-side only; key never reaches the client) ────
# Nation pays via OpenRouter — users get free credit automatically.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Upstream model for Nation's free-credit API. Default: openai/gpt-4o-mini.
# Claude / Anthropic slugs are rejected and fall back to the default.
NATION_OPENROUTER_MODEL=
# Override the OpenRouter base URL (leave empty for https://openrouter.ai/api/v1).
# OPENROUTER_API_URL=

# ── Nation branding ───────────────────────────────────────────────────────
# Display name shown on the pair/connect screen (heading + description).
# Defaults to "Nation Team Chat" when unset. Never shows the server hostname.
# Override with OMB_ENVIRONMENT_LABEL for per-instance labels if needed.
NATION_PUBLIC_NAME=

# ── Nation product admin gate ─────────────────────────────────────────────
# Set to 1 to expose engine and key settings to the local owner without a PIN.
# When unset, admin sections are hidden; use NATION_ADMIN_PIN for PIN-gated access.
NATION_PRODUCT_ADMIN=
# PIN required to unlock admin sections in Settings (optional).
NATION_ADMIN_PIN=

# ── OpenRouter (recommended — works without Anthropic/OpenAI keys) ─────────
# Get a free key at https://openrouter.ai/keys
# (OPENROUTER_API_KEY above covers both this section and Nation's free-credit API.)
# Model to use by default (any OpenRouter model id).
# See https://openrouter.ai/models for the full list.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Override the base URL if you use a different OpenAI-compatible endpoint.
# Defaults to https://openrouter.ai/api/v1 when OPENROUTER_API_KEY is set.
# OPENROUTER_API_URL=https://openrouter.ai/api/v1

# ── Legacy OpenAI-compat aliases (same driver, different env names) ────────
# OPENAI_COMPAT_API_KEY=   # alias for OPENROUTER_API_KEY
# OPENAI_COMPAT_MODEL=     # alias for OPENROUTER_MODEL
# OPENAI_COMPAT_URL=       # alias for OPENROUTER_API_URL

# NATION deployment theme JSON. Public responses contain only the applied brand.
# Use deploy/nation-brand.json for the standard NATION identity.
NATION_BRAND_FILE=./deploy/nation-brand.json

# Optional NATION-operated account email service; no upstream service is used by default.
NATION_ACCOUNT_SERVICE_URL=

# New installations use ~/.nationteamchat; existing data is reused in place.
# NATION_DATA_DIR=/absolute/path/to/nationteamchat
