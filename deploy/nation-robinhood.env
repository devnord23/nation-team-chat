# Approved top-up configuration: Robinhood Chain (4663) only. Treasury supplied by
# the founder on 2026-09-24 and re-confirmed for Robinhood Chain on 2026-09-26.
# API process overlay only; do not replace the existing .env file with this file.
# Contains no private keys. The receiving address is not a signing credential.
# Base (8453) is retired: the server ignores NATION_TREASURY_BASE.
NATION_TREASURY_ROBINHOOD=0x85E3C2D8f776d9D05b14E108F368070CbD8C1639
# $NATION is offered only while a USD price is set. Each invoice converts its USD
# amount at the price in effect when it is created; keep this near the market.
NATION_TOKEN_USD_PRICE=0.000286
# $NATION buyers send this share less for the same credit (0.2 = 20% off; 0 = none).
NATION_TOKEN_DISCOUNT=0.2
# Starter / Builder / Swarm. The server default, listed to replace an older 10,25,100 line.
NATION_PACKS_USD=15,49,99
