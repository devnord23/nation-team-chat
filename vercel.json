{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "/swarm/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/swarm/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/swarm/connectors/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/connectors/:path*"
    },
    {
      "source": "/connectors/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/connectors/:path*"
    },
    {
      "source": "/swarm/integrations/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/integrations/:path*"
    },
    {
      "source": "/integrations/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/integrations/:path*"
    },
    {
      "source": "/swarm/marketplace/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/marketplace/:path*"
    },
    {
      "source": "/marketplace/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/marketplace/:path*"
    },
    {
      "source": "/swarm/plugins/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/plugins/:path*"
    },
    {
      "source": "/plugins/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/plugins/:path*"
    },
    {
      "source": "/swarm/api/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/:path*"
    },
    {
      "source": "/swarm/.well-known/nationteamchat/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/.well-known/nationteamchat/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/:path*"
    },
    {
      "source": "/.well-known/nationteamchat/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/.well-known/nationteamchat/:path*"
    },
    {
      "source": "/swarm",
      "destination": "/swarm/index.html"
    },
    {
      "source": "/swarm/ledger",
      "destination": "/swarm/ledger/index.html"
    },
    {
      "source": "/swarm/ledger/",
      "destination": "/swarm/ledger/index.html"
    },
    {
      "source": "/swarm/:path*",
      "destination": "/swarm/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "cursor/nation-rebrand-zero-fingerprints-9a8c": false,
      "nation-scrub-openmuse": false,
      "nation-remove-connectors": false,
      "nation-crypto-credits": false
    }
  }
}
