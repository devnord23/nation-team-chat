# Copy to .env.local (gitignored). Never commit real values.
# Nation Cloud/VPS computer — SSH target for the live desktop path.
# Password-only auth is never accepted; a key is always required.
VPS_HOST=
VPS_USER=
VPS_SSH_PORT=22
VPS_LABEL=cloud-vps
VPS_SSH_ALIAS=nation-cloud-vps
VPS_AUTH_METHOD=key
# Provide one of the two key sources (path takes precedence if both are set):
VPS_SSH_KEY_PATH=
# Inline PEM key content — useful for containerised deployments.
VPS_SSH_KEY=

# New installations use ~/.nationteamchat; existing data is reused in place.
# NATION_DATA_DIR=/absolute/path/to/nationteamchat
